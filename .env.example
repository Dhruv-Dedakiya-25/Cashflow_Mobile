# Copy to .env.local and change as needed. .env.local is never committed.
# demo: sample data, no server. api: real sign-in and data from the CashFlow API.
EXPO_PUBLIC_AUTH_MODE=demo
# The API's address, ending in /api, such as the live site's: https://<live-site>/api
# Leave it out in development: the app then uses the dev server's /api, which
# metro.config.js forwards to the API running on this Mac (http://localhost:5100).
# EXPO_PUBLIC_API_URL=
